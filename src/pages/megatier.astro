---
import BaseLayout from "../layouts/BaseLayout.astro";

interface TierEntry {
  name: string;
  rationale?: string;
  change?: string;
  projection?: "Announced move" | "Unreleased";
  evidence?: {
    outrightAligned?: string;
    outright?: string;
    candyAligned?: string;
    conditional?: string;
  };
}

interface Tier {
  slug: string;
  label: string;
  principle?: string;
  entries: TierEntry[];
}

interface PlusMove {
  pokemon: string;
  move: string;
  basePower: number;
  effectivePower: number;
  party2Gain: string;
}

interface WeatherFinding {
  weather: string;
  boostedTypes: string;
  evidence: string;
}

interface SteelWeatherRow {
  weather: string;
  mewtwoX: string;
  lucarioZ: string;
  excadrill: string;
  heatran: string;
  background: string;
  result: string;
}

