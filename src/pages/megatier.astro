---
import BaseLayout from "../layouts/BaseLayout.astro";

interface TierEntry {
  name: string;
  rationale?: string;
  projection?: "Announced move" | "Unreleased";
  evidence?: {
    outrightAligned?: string;
    outright?: string;
    candyAligned?: string;
    conditional?: string;
  };
}

interface Tier {
  slug: string;
  label: string;
  principle?: string;
  entries: TierEntry[];
}

interface PlusMove {
  pokemon: string;
  move: string;
  basePower: number;
  effectivePower: number;
  party2Gain: string;
  availability: string;
  status: "Game Master stats" | "Projected timing";
  source: string;
}

const officialMegaUpdate = "https://pokemongo.com/news/more-mega-updates-2026";
const officialMegaChandelure =
