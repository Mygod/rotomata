---
import BaseLayout from "../layouts/BaseLayout.astro";

interface TierEntry {
  name: string;
  rationale?: string;
  change?: string;
  projection?: "Announced move" | "Unreleased";
  evidence?: {
    outrightAligned?: string;
    outright?: string;
    candyAligned?: string;
  };
}

interface Tier {
  slug: string;
  label: string;
  principle?: string;
  entries: TierEntry[];
}

interface PlusMove {
  pokemon: string;
  move: string;
  basePower: number;
  effectivePower: number;
  party2Gain: string;
}

const officialMegaUpdate = "https://pokemongo.com/news/more-mega-updates-2026";
const officialMegaSquads = "https://pokemongo.com/en/news/mega-squads-2026";
const officialRaidPool = "https://pokemongo.com/news/road-of-legends-2026?hl=en";
const officialMegaFinale = "https://pokemongo.com/gofest/megafinale";
const officialHoopaRaid = "https://pokemongo.com/post/elite-raids-new-feature?hl=en";
const officialMegaEncounter =
  "https://niantic.helpshift.com/hc/en/6-pokemon-go/faq/3336-i-defeated-a-mega-raid-boss-but-they-turned-back-into-their-regular-form-for-the-encounter/";
const officialMegaBoost =
  "https://niantic.helpshift.com/hc/en/6-pokemon-go/faq/3334-using-a-mega-evolved-pokemon/";
const originalTierList =
  "https://tiermaker.com/list/pokemon/pokemon-mega-evolutions-18840649/6197835";

const plusMoves: PlusMove[] = [
  {
    pokemon: "Mega Beedrill",
    move: "Fell Stinger+",
    basePower: 140,
    effectivePower: 182,
    party2Gain: "+106.9%",
  },
  {
    pokemon: "Mega Houndoom",
    move: "Dark Pulse+",
    basePower: 150,
    effectivePower: 195,
    party2Gain: "+55.9%",
